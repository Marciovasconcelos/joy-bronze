{
  "name": "joy-bronze-admin",
  "version": "1.0.2",
  "description": "Painel administrativo Joy Bronze",
  "main": "electron-main.cjs",
  "author": "Joy Bronze",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.joybronze.admin",
    "productName": "Joy Bronze - Administrador",
    "asar": true,

    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Joy-Bronze-Administrador-Setup-${version}.${ext}"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Joy Bronze - Administrador"
    },

    "publish": {
      "provider": "github",
      "owner": "Marciovasconcelos",
      "repo": "joy-bronze",
      "releaseType": "release"
    }
  }
}
